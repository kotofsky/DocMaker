<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net6.0;netcoreapp3.0;netcoreapp3.1;netstandard2.1;</TargetFrameworks>
		<RestorePackages>true</RestorePackages>
		<Authors>Artem Rudiakov</Authors>
		<Product>DocMaker</Product>
		<Description>Simple library to generate word and excel documents with fields and tables. Can work with large datasets for excel up to 1M rows.</Description>
		<AssemblyVersion>2.0.1</AssemblyVersion>
 		<FileVersion>2.0.1</FileVersion>
    	<VersionPrefix>2.0.1</VersionPrefix>
		<SignAssembly>true</SignAssembly>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyOriginatorKeyFile>sign.snk</AssemblyOriginatorKeyFile>
		<OutputType>Library</OutputType>
		<LangVersion>preview</LangVersion>
		<Title>DocMaker</Title>
		<Copyright>Copyright (c) 2018 Artem Rudiakov</Copyright>
		<PackageProjectUrl>https://github.com/kotofsky/DocMaker</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\..\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DocumentFormat.OpenXml" Version="2.19.0" />
	</ItemGroup>

	<ItemGroup Condition="('$(TargetFramework)'=='net46') Or ('$(TargetFramework)'=='net461')">
		<Reference Include="System.Core" />
		<Reference Include="System.Linq" />
	</ItemGroup>

	<ItemGroup Condition="('$(TargetFramework)'=='netstandard1.6') Or ('$(TargetFramework)'=='netstandard2.0')">
		<Reference Include="System.Linq" />
	</ItemGroup>

</Project>
